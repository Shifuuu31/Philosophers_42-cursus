# ==============================================================================
# 42 Philosophers — .gitignore
# ==============================================================================

# Binaries & Executables
philo
philo_bonus
philo_tsan
*.a
*.so
*.out

# Object files & build artifacts
obj/
*.o
*.dSYM/

# Python & test caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Editor & IDE configurations
.vscode/
.idea/
*.swp
*.swo
*~

# Operating System artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Tester outputs, logs & temporary files
*.log
tempfile
fails/

# External Testers (cloned locally, not tracked)
LazyPhilosophersTester/
alientest_philosopher/
42-philosophers-tester/
